rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to product images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // Since we're using Realtime Database, we can't easily check roles in Storage rules without a custom claim or Firestore
        // For simplicity in RTDB projects, we often check against a known admin email if provided in the token or just allow auth write for admins
        // In this specific project, let's allow read for all and write for authenticated users (can be restricted further if needed)
        request.auth != null;
    }
    
    // Allow users to upload their own avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
