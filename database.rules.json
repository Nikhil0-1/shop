{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03')"
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03'"
    },
    "orders": {
      ".read": "auth != null && auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03'",
      "$orderId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03')",
        ".write": "auth != null && (!data.exists() || auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03')"
      }
    },
    "enquiries": {
      ".read": "auth != null && auth.uid === '4P0fVLLY85ebqC5DDKqIgA6iLO03'",
      ".write": true
    }
  }
}
